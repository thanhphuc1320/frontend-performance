# Local PostgreSQL
POSTGRES_PASSWORD=commerce_local
DATABASE_URL=postgresql://postgres:commerce_local@127.0.0.1:55432/commerce

# Local Redis
REDIS_PASSWORD=commerce_local
REDIS_URL=redis://:commerce_local@127.0.0.1:56379

# API
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Session
SESSION_COOKIE_NAME=commerce_session

# Auth policy (non-secret)
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_SECONDS=900
AUTH_VERIFICATION_TOKEN_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
AUTH_EMAIL_CHANGE_TOKEN_TTL_SECONDS=3600

# Local email capture. Production uses smtp and a deployment-only SMTP_URL.
EMAIL_DELIVERY_MODE=memory
EMAIL_FROM=no-reply@localhost.test
